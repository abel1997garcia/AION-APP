# ============================================================
# AION CRYPTO TRADING BOT - CONFIGURACION
# Copia este archivo a .env y rellena tus valores
# ============================================================

# --- WALLET (Polygon/EVM private key para Polymarket) ---
PRIVATE_KEY=0xTU_PRIVATE_KEY_AQUI

# --- POLYMARKET ---
# Chain ID: 137 = Polygon Mainnet
POLYMARKET_CHAIN_ID=137
# Host del CLOB API (no cambiar)
POLYMARKET_HOST=https://clob.polymarket.com
# Funder address (la misma que derive de tu private key, dejar vacio para auto-detectar)
POLYMARKET_FUNDER=

# --- BINANCE (solo para datos, no se necesita para operar) ---
# Opcional: mejora rate limits si tienes cuenta
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- ESTRATEGIA ---
# Porcentaje maximo del portfolio por operacion (0.05 = 5%, 0.15 = 15%)
MAX_POSITION_PCT=0.10
# Diferencia minima de probabilidad para entrar (0.08 = 8%)
MIN_EDGE_THRESHOLD=0.08
# Minimo de confianza del predictor para operar (0.0-1.0)
MIN_CONFIDENCE=0.65
# Maximo de operaciones abiertas simultaneas
MAX_OPEN_POSITIONS=5
# USDC minimo por operacion
MIN_ORDER_SIZE=10
# USDC maximo por operacion
MAX_ORDER_SIZE=500

# --- CRYPTOS A MONITOREAR ---
# Separadas por comas
TRACKED_SYMBOLS=BTC,ETH,SOL

# --- LOGS ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
