# =============================================
# POLYMARKET CONFIGURATION
# =============================================
# Private key of your Polygon wallet (hex, with or without 0x prefix)
POLYMARKET_PRIVATE_KEY=0xyour_private_key_here

# Polymarket CLOB API endpoint (leave default for mainnet)
POLYMARKET_HOST=https://clob.polymarket.com

# Polygon chain ID: 137 = mainnet, 80001 = Mumbai testnet
POLYMARKET_CHAIN_ID=137

# =============================================
# BINANCE CONFIGURATION
# =============================================
# No API key needed for public price data
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_REST_URL=https://api.binance.com

# =============================================
# RISK MANAGEMENT
# =============================================
# Maximum USDC per individual position
MAX_POSITION_USDC=200.0

# Minimum edge (theoretical_prob - market_price) to trigger a trade
# 0.015 = 1.5%
MIN_EDGE_THRESHOLD=0.015

# Maximum total USDC exposure across all open positions
MAX_TOTAL_EXPOSURE_USDC=1000.0

# Kelly fraction multiplier (0.5 = half-Kelly, recommended for safety)
KELLY_FRACTION=0.5

# Minimum probability of a market before trading (avoid near-certain markets)
MIN_MARKET_PROB=0.02
MAX_MARKET_PROB=0.98

# =============================================
# BOT CONFIGURATION
# =============================================
# How often (seconds) to refresh the list of active Polymarket markets
MARKET_SCAN_INTERVAL_SECONDS=300

# How often (seconds) to re-evaluate opportunities after a price update
ARBITRAGE_CHECK_INTERVAL_SECONDS=10

# BTC annualized volatility override (optional: if empty, fetched from Binance)
# Example: 0.80 for 80% annualized vol
BTC_ANNUAL_VOL_OVERRIDE=

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
